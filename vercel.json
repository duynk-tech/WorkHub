{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && npx prisma db push --skip-generate && next build",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/quotation-expiry",
      "schedule": "5 17 * * *"
    },
    {
      "path": "/api/cron/attendance-rollup",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/sales-maintenance",
      "schedule": "15 19 * * *"
    },
    {
      "path": "/api/cron/recurring-tasks",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/overdue-tasks",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/approval-sla",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/outbox",
      "schedule": "10 3 * * *"
    },
    {
      "path": "/api/cron/low-stock",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/debt-reminders",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/report-schedules",
      "schedule": "30 0 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  }
}
