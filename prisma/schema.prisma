enum NotifyChannel {
  ZALO
  IN_APP
  EMAIL
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model NotificationTemplate {
  code          String        @id @db.VarChar(64)
  name          String        @db.VarChar(191)
  channel       NotifyChannel @default(ZALO)
  title         String?       @db.VarChar(255)
  bodyTemplate  String        @db.Text
  variablesJson Json?
  isActive      Boolean       @default(true)
  updatedAt     DateTime      @updatedAt
}

model NotificationOutbox {
  id                  Int           @id @default(autoincrement())
  channel             NotifyChannel @default(ZALO)
  templateCode        String?       @db.VarChar(64)
  recipientEmployeeId Int?
  zaloUserId          String?       @db.VarChar(191)
  title               String?       @db.VarChar(255)
  body                String        @db.Text
  payloadJson         Json?
  linkUrl             String?       @db.VarChar(512)
  status              OutboxStatus  @default(PENDING)
  attempts            Int           @default(0)
  sendAfter           DateTime      @default(now())
  sentAt              DateTime?
  error               String?       @db.Text
  dedupeKey           String?       @unique @db.VarChar(191)
  createdAt           DateTime      @default(now())

  recipient Employee? @relation(fields: [recipientEmployeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

