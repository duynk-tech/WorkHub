  @@index([recipientEmployeeId])
}

model InAppNotification {
  id        Int       @id @default(autoincrement())
  userId    Int
  title     String    @db.VarChar(255)
  body      String    @db.Text
  linkUrl   String?   @db.VarChar(512)
  icon      String?   @db.VarChar(32)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, readAt])
}

model ZaloLinkCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(16)
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model ZaloInboundLog {
  id          Int      @id @default(autoincrement())
  messageId   String?  @unique @db.VarChar(191)
  zaloUserId  String?  @db.VarChar(191)
  text        String?  @db.Text
  payloadJson Json?
  handled     Boolean  @default(false)
  response    String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([zaloUserId])
}

