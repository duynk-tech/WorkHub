# Database (Supabase PostgreSQL)
# Transaction Pooler (port 6543) dùng cho Vercel Serverless runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct / Session connection (port 5432) dùng cho Prisma migrate / db push
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase Storage (lưu trữ ảnh upload, avatar, media library trên Vercel)
# Hỗ trợ cả NEXT_PUBLIC_SUPABASE_URL (từ Vercel-Supabase integration) hoặc SUPABASE_URL
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"
# Realtime cho Không gian 3D (di chuyển + chat). Bỏ trống → /3d chạy chế độ tĩnh.
# Lấy ở Supabase → Project Settings → API (anon key, JWT secret). Nhớ chạy supabase/realtime_policies.sql
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""

# Application URL & General
APP_URL="http://localhost:3000"
APP_NAME="WorkHub"
TZ="Asia/Ho_Chi_Minh"

# Security keys
AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789abcdef"
APP_ENCRYPTION_KEY="ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE="
CRON_SECRET="dev-cron-secret"

# AI security: exact HTTPS origins, comma-separated. Empty denies custom HTTP tools.
AI_TOOL_ALLOWED_ORIGINS=
# Gemini is allowed by default; list additional approved LLM provider origins here.
AI_PROVIDER_ALLOWED_ORIGINS=
# AI defaults to read-only. Enabling writes still requires the user's tool permissions.
AI_AGENT_ALLOW_WRITES=false
