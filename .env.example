# Database (MariaDB / MySQL)
DATABASE_URL="mysql://workhub:workhub_dev_pw@127.0.0.1:3306/workhub"
SHADOW_DATABASE_URL="mysql://workhub:workhub_dev_pw@127.0.0.1:3306/workhub_shadow"

# Application URL & General
APP_URL="http://localhost:3000"
APP_NAME="WorkHub"
TZ="Asia/Ho_Chi_Minh"

# Security keys
AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789abcdef"
APP_ENCRYPTION_KEY="ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE="
CRON_SECRET="dev-cron-secret"

# Background scheduler
ENABLE_SCHEDULER="false"

# AI security: exact HTTPS origins, comma-separated. Empty denies custom HTTP tools.
AI_TOOL_ALLOWED_ORIGINS=
# Gemini is allowed by default; list additional approved LLM provider origins here.
AI_PROVIDER_ALLOWED_ORIGINS=
# AI defaults to read-only. Enabling writes still requires the user's tool permissions.
AI_AGENT_ALLOW_WRITES=false
